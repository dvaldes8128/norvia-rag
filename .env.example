# ---- Norvia RAG environment (copy to .env; never commit real secrets) ----

# App
APP_ENV=local
LOG_LEVEL=INFO

# Database (PostgreSQL + pgvector)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=norvia
POSTGRES_PASSWORD=norvia
POSTGRES_DB=norvia
# App connects as a restricted role (RLS applies); migrations use the admin role.
DATABASE_URL=postgresql+psycopg://norvia_app:norvia_app@db:5432/norvia
ADMIN_DATABASE_URL=postgresql+psycopg://norvia:norvia@db:5432/norvia
APP_DB_PASSWORD=norvia_app

# Redis (Celery broker + result backend)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Auth (both API key and JWT supported)
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Demo tenant API keys map (tenant_id:api_key, comma-separated) — local only
TENANT_API_KEYS=acme:devkey-acme,globex:devkey-globex
# Platform admin key for /admin/* and the SPA Admin tab (empty disables admin API)
ADMIN_API_KEY=dev-admin-key

# Providers: deterministic fake by default; set to "real" to use the custom adapter
LLM_PROVIDER=fake
EMBEDDINGS_PROVIDER=fake
EMBEDDINGS_DIM=768

# Real provider adapter (only read when *_PROVIDER=real) — leave empty in repo
REAL_LLM_BASE_URL=
REAL_LLM_API_KEY=
REAL_LLM_MODEL=
REAL_EMBEDDINGS_BASE_URL=
REAL_EMBEDDINGS_API_KEY=
REAL_EMBEDDINGS_MODEL=

# Provider resilience
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=3
PROVIDER_BACKOFF_BASE_SECONDS=0.5

# Chunking (D1): ~800-1000 tokens, 15-20% overlap
CHUNK_SIZE_TOKENS=900
CHUNK_OVERLAP_TOKENS=150

# Retrieval
RETRIEVAL_TOP_K=5
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_TEXT_WEIGHT=0.4
# Near-copy fuzzy gate (token_set_ratio 0–100). 95 default; 0 disables.
# NL questions vs policy prose often score ~70 — lower/disable for open QA/eval.
RETRIEVAL_NEAR_COPY_MIN_RATIO=95

# Citation lexical thresholds (used when /ask lexical_grounding=true)
CITATION_MIN_OVERLAP_TOKENS=2
CITATION_MIN_OVERLAP_RATIO=0.15

# Uploads (API + worker share this path via the compose volume)
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25

# OpenTelemetry
OTEL_SERVICE_NAME=norvia-rag
OTEL_TRACES_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=
